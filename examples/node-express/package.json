{
  "name": "cfd-example-node-express",
  "version": "0.1.0",
  "private": true,
  "description": "CFD example: layered Node/Express + Postgres notification API",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --exclude 'src/**/data/**'",
    "test:integration": "vitest run 'src/**/data/**/*.test.ts'",
    "test": "npm run test:unit && npm run test:integration",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "migrate:test": "psql \"$TEST_DATABASE_URL\" -f migrations/001-create-notifications.sql"
  },
  "dependencies": {
    "express": "^5.0.0",
    "pg": "^8.11.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
